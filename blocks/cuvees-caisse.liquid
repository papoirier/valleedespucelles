{%- doc -%}
  Affiche les données techniques de chaque cuvée contenue dans une caisse mixte,
  une rangée d'accordéon par cuvée.

  Source : métachamp produit « custom.cuvees » (Liste de références de produits)
  rempli sur le produit de la caisse. Les données de chaque cuvée sont lues
  directement dans ses propres métachamps : rien à ressaisir.
{%- enddoc -%}

{% assign cuvees = closest.product.metafields.custom.cuvees.value %}

{% if cuvees != blank %}
  <div
    class="accordion accordion--caret accordion--dividers cuvees-caisse"
    style="
      --summary-font-family: var(--font-{{ block.settings.type_preset }}--family);
      --summary-font-style: var(--font-{{ block.settings.type_preset }}--style);
      --summary-font-weight: var(--font-{{ block.settings.type_preset }}--weight);
      --summary-font-size: var(--font-{{ block.settings.type_preset }}--size);
      --summary-font-line-height: var(--font-{{ block.settings.type_preset }}--line-height);
      --summary-font-case: var(--font-{{ block.settings.type_preset }}--case);
      --border-width: 0; --border-style: none;
    "
    {{ block.shopify_attributes }}
  >
    {% for cuvee in cuvees %}
      {% liquid
        assign t = cuvee.metafields.technique
        assign c = cuvee.metafields.custom
        assign is_open = false
        if block.settings.open_first and forloop.first
          assign is_open = true
        endif
      %}

      {% capture row %}
        <details class="details" data-testid="accordion-details" {% if is_open %}open{% endif %}>
          <summary class="details__header">
            {{ cuvee.title }}
            <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
            <span class="svg-wrapper icon-plus">
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </span>
          </summary>

          <div class="details-content rte">
            {% if t.millesime != blank %}
              <p>Millésime : {{ t.millesime.value }}</p>
            {% endif %}
            {% if t.cepages != blank %}
              <p>Cépage(s) :&nbsp;</p>{{ t.cepages | metafield_tag: field: 'nom' }}
            {% endif %}
            {% if t.couleur != blank %}
              <p>Couleur : {{ t.couleur.value.nom.value }}</p>
            {% endif %}
            {% if t.taux_alcool != blank %}
              <p>Taux d'alcool : {{ t.taux_alcool.value }}% alc/vol</p>
            {% endif %}
            {% if c.agriculture != blank %}
              <p>Agriculture : {{ c.agriculture.value.nom.value }}</p>
            {% endif %}
            {% if t.lieu != blank %}
              <p>Lieu de récolte :&nbsp;</p>{{ t.lieu | metafield_tag: field: 'nom' }}
            {% endif %}
            {% if c.parcelles != blank %}
              <p>Parcelle(s) :&nbsp;</p>{{ c.parcelles | metafield_tag: field: 'nom' }}
            {% endif %}
            {% if c.ingredients != blank %}
              <p>Ingrédients :&nbsp;</p>{{ c.ingredients | metafield_tag: field: 'nom' }}
            {% endif %}
            {% if t.intrants != blank %}
              <p>Intrants œnologiques :&nbsp;</p>{{ t.intrants | metafield_tag: field: 'nom' }}
            {% endif %}

            {% if block.settings.show_link %}
              <p class="cuvees-caisse__lien">
                <a href="{{ cuvee.url }}">{{ block.settings.link_label }}</a>
              </p>
            {% endif %}
          </div>
        </details>
      {% endcapture %}

      {% render 'accordion-custom-component',
        children: row,
        open_by_default_on_desktop: is_open,
        open_by_default_on_mobile: is_open
      %}
    {% endfor %}
  </div>

  {% render 'accordion-styles' %}
{% endif %}

{% stylesheet %}
  .cuvees-caisse__lien {
    margin-block-start: var(--margin-sm, 0.75rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cuvées de la caisse",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Affiche une rangée par cuvée listée dans le métachamp produit custom.cuvees."
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Style des titres",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraphe" }
      ],
      "default": "h6"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Ouvrir la première cuvée par défaut",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Lien vers la fiche de chaque cuvée",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texte du lien",
      "default": "Voir la fiche complète"
    }
  ],
  "presets": [
    {
      "name": "Cuvées de la caisse"
    }
  ]
}
{% endschema %}
