{%- doc -%}
  Affiche les données techniques de chaque cuvée contenue dans une caisse mixte,
  une rangée d'accordéon par cuvée.

  Source : métachamp produit « custom.cuvees » (Liste de références de produits)
  rempli sur le produit de la caisse. Les données de chaque cuvée sont lues
  directement dans ses propres métachamps : rien à ressaisir.
{%- enddoc -%}

{% assign cuvees = closest.product.metafields.custom.cuvees.value %}

{% if cuvees != blank %}
  <div class="cuvees-caisse__wrapper" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <p class="cuvees-caisse__titre {{ block.settings.heading_preset }}">{{ block.settings.heading }}</p>
  {% endif %}
  <div
    class="accordion accordion--caret accordion--dividers cuvees-caisse"
    style="
      --summary-font-family: var(--font-{{ block.settings.type_preset }}--family);
      --summary-font-style: var(--font-{{ block.settings.type_preset }}--style);
      --summary-font-weight: var(--font-{{ block.settings.type_preset }}--weight);
      --summary-font-size: var(--font-{{ block.settings.type_preset }}--size);
      --summary-font-line-height: var(--font-{{ block.settings.type_preset }}--line-height);
      --summary-font-case: var(--font-{{ block.settings.type_preset }}--case);
      --border-width: 0; --border-style: none;
    "
  >
    {% for cuvee in cuvees %}
      {% liquid
        assign t = cuvee.metafields.technique
        assign c = cuvee.metafields.custom
        assign is_open = false
        if block.settings.open_first and forloop.first
          assign is_open = true
        endif
      %}

      {% capture row %}
        <details class="details" data-testid="accordion-details" {% if is_open %}open{% endif %}>
          <summary class="details__header">
            {{ cuvee.title }}
            <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
            <span class="svg-wrapper icon-plus">
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </span>
          </summary>

          <div class="details-content cuvees-caisse__fiche">
            {% comment %}
              Une ligne par champ. metafield_text sort du texte brut (valeurs
              séparées par des virgules pour les listes), ce qui évite les
              <ul> de metafield_tag et les règles d'alignement inline du thème.
            {% endcomment %}
            {% if t.millesime != blank %}
              <p><span class="cuvees-caisse__label">Millésime :</span> {{ t.millesime.value }}</p>
            {% endif %}
            {% if t.cepages != blank %}
              <p><span class="cuvees-caisse__label">Cépage(s) :</span> {{ t.cepages | metafield_text: field: 'nom' }}</p>
            {% endif %}
            {% if t.couleur != blank %}
              <p><span class="cuvees-caisse__label">Couleur :</span> {{ t.couleur | metafield_text: field: 'nom' }}</p>
            {% endif %}
            {% if t.taux_alcool != blank %}
              <p><span class="cuvees-caisse__label">Taux d'alcool :</span> {{ t.taux_alcool.value }}&nbsp;% alc./vol.</p>
            {% endif %}
            {% if c.agriculture != blank %}
              <p><span class="cuvees-caisse__label">Agriculture :</span> {{ c.agriculture | metafield_text: field: 'nom' }}</p>
            {% endif %}
            {% if c.ingredients != blank %}
              <p><span class="cuvees-caisse__label">Ingrédients :</span> {{ c.ingredients | metafield_text: field: 'nom' }}</p>
            {% endif %}
            {% if t.intrants != blank %}
              <p><span class="cuvees-caisse__label">Intrants œnologiques :</span> {{ t.intrants | metafield_text: field: 'nom' }}</p>
            {% endif %}

            {% if c.degustation != blank %}
              <div class="cuvees-caisse__degustation">
                <p class="cuvees-caisse__label">Notes de dégustation :</p>
                {% if c.degustation.type == 'rich_text_field' %}
                  <div class="rte">{{ c.degustation | metafield_tag }}</div>
                {% else %}
                  <p>{{ c.degustation.value | escape | newline_to_br }}</p>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.show_link %}
              <p class="cuvees-caisse__lien">
                <a href="{{ cuvee.url }}">{{ block.settings.link_label }}</a>
              </p>
            {% endif %}
          </div>
        </details>
      {% endcapture %}

      {% render 'accordion-custom-component',
        children: row,
        open_by_default_on_desktop: is_open,
        open_by_default_on_mobile: is_open
      %}
    {% endfor %}
  </div>

  </div>

  {% render 'accordion-styles' %}
{% elsif request.design_mode %}
  <p {{ block.shopify_attributes }} style="padding: 0.75rem; border: 1px dashed currentColor; opacity: 0.7;">
    Cuvées de la caisse : aucune cuvée trouvée dans le métachamp custom.cuvees de « {{ closest.product.title | default: 'produit introuvable' }} ».
  </p>
{% endif %}

{% stylesheet %}
  .cuvees-caisse__wrapper {
    width: 100%;
  }

  .cuvees-caisse__titre {
    margin: 0 0 0.75rem;
  }

  .cuvees-caisse__fiche p {
    display: block;
    margin: 0 0 0.35em;
  }

  .cuvees-caisse__fiche p:last-child {
    margin-block-end: 0;
  }

  .cuvees-caisse__degustation {
    margin-block-start: 0.9em;
  }

  .cuvees-caisse__degustation .rte > :last-child {
    margin-block-end: 0;
  }

  .cuvees-caisse__fiche .cuvees-caisse__lien {
    margin-block-start: 0.9em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cuvées de la caisse",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Affiche une rangée par cuvée listée dans le métachamp produit custom.cuvees."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Fiches techniques des cuvées"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "Style du titre",
      "options": [
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraphe" }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Style des noms de cuvées",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraphe" }
      ],
      "default": "h6"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Ouvrir la première cuvée par défaut",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Lien vers la fiche de chaque cuvée",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texte du lien",
      "default": "Voir la fiche complète"
    }
  ],
  "presets": [
    {
      "name": "Cuvées de la caisse"
    }
  ]
}
{% endschema %}
