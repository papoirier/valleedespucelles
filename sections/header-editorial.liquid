{% comment %}
  Section contract.
  En-tête éditorial : une courte phrase qui rappelle la page d'accueil, à la place
  du logo et du menu. Ex. : « domaine de la vallée des pucelles. vin, à propos, contact. »
  Les liens viennent du menu choisi ; « panier (n) » s'ajoute quand le panier n'est pas vide.
  La page d'accueil masque le groupe d'en-tête (voir layout/theme.liquid) : elle a déjà sa phrase.
  @example
  <!-- Groupe d'en-tête > En-tête éditorial, menu « main-menu » -->
{% endcomment %}

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign title = section.settings.title | default: shop.name
-%}

<header class="header-editorial page-width">
  <p class="header-editorial__phrase">
    <a href="{{ routes.root_url }}" class="header-editorial__titre">
      {{- title | escape -}}
    </a>.
    {%- if menu.links.size > 0 %}
      <nav class="header-editorial__nav" aria-label="{{ menu.title | escape }}">
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
            {{- link.title | escape -}}
          </a>
          {%- unless forloop.last -%}, {% endunless -%}
        {%- endfor -%}
        <span class="header-editorial__panier"{% if cart.item_count == 0 %} hidden{% endif %}>,
          <a href="{{ routes.cart_url }}">
            {{- 'home.header_cart' | t -}}
            {{ ' ' -}}(<span data-header-cart-count>{{ cart.item_count }}</span>)
          </a>
        </span>.
      </nav>
    {%- endif -%}
    {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
      {%- for language in localization.available_languages -%}
        {%- unless language.iso_code == localization.language.iso_code %}
          ›&#8202;<a href="{{ language.root_url }}" hreflang="{{ language.iso_code }}" lang="{{ language.iso_code }}">
            {%- if language.iso_code == 'en' -%}english{%- else -%}français{%- endif -%}
          </a>
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </p>
</header>

<script type="module">
  import { StandardEvents } from '@shopify/events';

  // Garde « panier (n) » à jour après un ajout au panier, sans recharger la page.
  document.addEventListener(StandardEvents.cartLinesUpdate, (event) => {
    event.promise
      ?.then(({ cart, detail }) => {
        const count = cart?.totalQuantity ?? detail?.itemCount ?? 0;
        for (const el of document.querySelectorAll('[data-header-cart-count]')) el.textContent = String(count);
        for (const el of document.querySelectorAll('.header-editorial__panier')) el.hidden = count === 0;
      })
      .catch(() => {});
  });
</script>

{% stylesheet %}
  .header-editorial {
    padding-block: 1.5rem;
  }

  .header-editorial__phrase {
    margin: 0;
    max-width: 40ch;
    font-family: var(--pucelles-fonte);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: lowercase;
    color: var(--pucelles-encre);
    overflow-wrap: break-word;
  }

  .header-editorial__nav {
    display: inline;
  }

  .header-editorial__titre {
    color: inherit;
    text-decoration: none;
  }

  .header-editorial__nav a,
  .header-editorial__phrase > a[hreflang] {
    color: var(--pucelles-rouge);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .header-editorial a:hover,
  .header-editorial a[aria-current='page'] {
    color: var(--pucelles-rouge-survol);
  }

  .header-editorial a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "En-tête éditorial",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "domaine de la vallée des pucelles",
      "info": "Laissez vide pour utiliser le nom de la boutique."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Les liens du menu forment la phrase : « vin, à propos, contact. »"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Afficher le lien de langue",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "En-tête éditorial"
    }
  ]
}
{% endschema %}
